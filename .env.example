# ---------- TelegramParser: bot (admin panel, aiogram) ----------
TP_BOT_TOKEN=

# ---------- TelegramParser: userbot (pyrogram/pyrotgfork) ----------
TP_API_ID=
TP_API_HASH=
TP_SESSION_NAME=parser_session
TP_ERROR_CHAT=

# ---------- LavandaAds (прайс на рекламу, без БД) ----------
ADS_BOT_TOKEN=
